ini controller :
package controllers

import (
    "net/http"
    "samsat_backend/config"
    "samsat_backend/models"

    "github.com/gin-gonic/gin"
)

// 🔹 Login admin global
func AdminLogin(c *gin.Context) {
    var input struct {
        Username string `json:"username"`
        Password string `json:"password"`
    }

    if err := c.ShouldBindJSON(&input); err != nil {
        c.JSON(http.StatusBadRequest, gin.H{"error": "Input tidak valid"})
        return
    }

    var admin models.Admin
    if err := config.DB.Where("username = ?", input.Username).First(&admin).Error; err != nil {
        c.JSON(http.StatusUnauthorized, gin.H{"error": "Username tidak ditemukan"})
        return
    }

    if admin.Password != input.Password {
        c.JSON(http.StatusUnauthorized, gin.H{"error": "Password salah"})
        return
    }

    c.JSON(http.StatusOK, gin.H{
        "status":  "success",
        "message": "Login berhasil",
        "data": gin.H{
            "id":       admin.ID,
            "username": admin.Username,
            "nama":     admin.Nama,
            "role":     admin.Role,
        },
    })
}
