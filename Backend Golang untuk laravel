// ======================================================
// CREATE NOTIFICATION
// ======================================================
func CreateNotification(c *gin.Context) {
	var req models.CreateNotificationRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"success": false, "message": err.Error()})
		return
	}

	notification := models.Notification{
		NomorHP:        req.NomorHP,
		Title:          req.Title,
		Message:        req.Message,
		Type:           req.Type,
		ReferenceTable: req.ReferenceTable,
		ReferenceID:    req.ReferenceID,
		IsRead:         false,
	}

	if err := config.DB.Create(&notification).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "message": "Gagal menyimpan notifikasi"})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"data":    notification.ToResponse(),
	})
}

// ======================================================
// GET NOTIFICATIONS BY NOMOR_HP
// ======================================================
func GetNotifications(c *gin.Context) {
	nomorHP := c.Query("nomor_hp")
	if nomorHP == "" {
		c.JSON(http.StatusBadRequest, gin.H{"success": false, "message": "nomor_hp wajib diisi"})
		return
	}

	var notifications []models.Notification
	if err := config.DB.
		Where("nomor_hp = ?", nomorHP).
		Order("created_at DESC").
		Find(&notifications).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "message": "Gagal mengambil data"})
		return
	}

	var responses []models.NotificationResponse
	for _, n := range notifications {
		responses = append(responses, n.ToResponse())
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"data":    responses,
	})
}

// ======================================================
// MARK NOTIFICATION AS READ
// ======================================================
func MarkNotificationAsRead(c *gin.Context) {
	var req models.MarkReadRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"success": false, "message": err.Error()})
		return
	}

	var notif models.Notification
	if err := config.DB.
		Where("id = ? AND nomor_hp = ?", req.NotificationID, req.NomorHP).
		First(&notif).Error; err != nil {
		c.JSON(http.StatusNotFound, gin.H{"success": false, "message": "Notifikasi tidak ditemukan"})
		return
	}

	notif.IsRead = true
	if err := config.DB.Save(&notif).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "message": "Gagal memperbarui status baca"})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"message": "Notifikasi berhasil ditandai sebagai dibaca",
	})
}

// ======================================================
// DELETE NOTIFICATION
// ======================================================
func DeleteNotification(c *gin.Context) {
	id := c.Param("id")

	if err := config.DB.Delete(&models.Notification{}, id).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "message": "Gagal menghapus notifikasi"})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"message": "Notifikasi berhasil dihapus",
	})
}


