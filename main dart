void main() async {
  WidgetsFlutterBinding.ensureInitialized();

  // Inisialisasi Awesome Notifications
  await AwesomeNotifications().initialize(
    null,
    [
      NotificationChannel(
        channelKey: 'basic_channel',
        channelName: 'Basic Notifications',
        channelDescription: 'Channel untuk notifikasi dasar',
        defaultColor: Color(0xFF0057A3),
        ledColor: Colors.white,
        importance: NotificationImportance.High,
        channelShowBadge: true,
        playSound: true,
        enableVibration: true,
        icon: 'resource://drawable/ic_launcher',
      ),
    ],
    debug: true,
  );

  // Request permission
  await AwesomeNotifications().isNotificationAllowed().then((isAllowed) {
    if (!isAllowed) {
      AwesomeNotifications().requestPermissionToSendNotifications();
    }
  });

  runApp(const MyApp());
}

void showCustomSnackBar(BuildContext context, String message,
    {bool success = true}) {
  final overlay = Overlay.of(context);

  late OverlayEntry overlayEntry;
  overlayEntry = OverlayEntry(
    builder: (context) => Positioned(
      bottom: 30,
      left: 20,
      right: 20,
      child: TweenAnimationBuilder<double>(
        duration: const Duration(milliseconds: 500),
        curve: Curves.easeOutBack,
        tween: Tween(begin: 50, end: 0),
        builder: (context, offset, child) {
          final opacity = ((50 - offset) / 50).clamp(0.0, 1.0);
          return Opacity(
            opacity: opacity,
            child: Transform.translate(
              offset: Offset(0, offset),
              child: child,
            ),
          );
        },
        child: Material(
          color: Colors.transparent,
          child: Container(
            decoration: BoxDecoration(
              gradient: LinearGradient(
                colors: success
                    ? [
                        Color.fromARGB(255, 0, 152, 53),
                        Color.fromARGB(255, 0, 152, 53)
                      ]
                    : [
                        Color.fromARGB(255, 255, 0, 0),
                        Color.fromARGB(255, 255, 38, 0)
                      ],
                begin: Alignment.topLeft,
                end: Alignment.bottomRight,
              ),
              borderRadius: BorderRadius.circular(15),
              boxShadow: [
                BoxShadow(
                    color: Colors.black26, blurRadius: 8, offset: Offset(0, 3))
              ],
            ),
            padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
            child: Row(
              children: [
                Icon(success ? Icons.check_circle_outline : Icons.error_outline,
                    color: Colors.white, size: 26),
                const SizedBox(width: 12),
                Expanded(
                  child: Text(
                    message,
                    style: const TextStyle(
                        color: Colors.white,
                        fontSize: 15,
                        fontWeight: FontWeight.w500),
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    ),
  );

  overlay.insert(overlayEntry);

  Future.delayed(const Duration(seconds: 3)).then((_) async {
    for (double i = 1.0; i >= 0; i -= 0.1) {
      await Future.delayed(const Duration(milliseconds: 25));
      overlayEntry.markNeedsBuild();
    }
    overlayEntry.remove();
  });
}

// ========== NOTIFICATION SERVICE ==========
class NotificationService {
  static final NotificationService _instance = NotificationService._internal();
  factory NotificationService() => _instance;
  NotificationService._internal();

  Timer? _pollingTimer;
  String? _lastNotificationId;
  bool _isRunning = false;

  // Base URL Golang Backend - GANTI DENGAN URL ANDA
  static const String baseUrl = 'http://10.0.2.2:8080';

  // Mulai polling notifikasi
  void startPolling({int intervalSeconds = 30}) {
    if (_isRunning) return;

    _isRunning = true;
    print('🔔 Notification polling started (interval: ${intervalSeconds}s)');

    // Cek langsung saat start
    _checkForNotifications();

    // Lalu cek secara berkala
    _pollingTimer = Timer.periodic(
      Duration(seconds: intervalSeconds),
      (timer) => _checkForNotifications(),
    );
  }

  // Stop polling
  void stopPolling() {
    _pollingTimer?.cancel();
    _pollingTimer = null;
    _isRunning = false;
    print('🔕 Notification polling stopped');
  }

  // Cek notifikasi baru dari server
  Future<void> _checkForNotifications() async {
    try {
      SharedPreferences prefs = await SharedPreferences.getInstance();
      String? userId = prefs.getString('user_id');
      String? token =
          prefs.getString('token'); // Ambil JWT token dari storage

      if (userId == null || token == null) {
        print('⚠ User ID or JWT token not found, skipping notification check');
        return;
      }

      print('📡 Checking notifications for user: $userId');

      final response = await http.get(
        Uri.parse('$baseUrl/api/notifications/$userId'),
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer $token', // <-- tambahkan ini
        },
      ).timeout(const Duration(seconds: 10));

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);
        print('📦 Notification response: $data');

        if (data['has_new'] == true && data['notification'] != null) {
          final notification = data['notification'];
          String notificationId = notification['id'].toString();

          if (_lastNotificationId != notificationId) {
            _lastNotificationId = notificationId;
            await _showNotification(notification);

            // Mark notification sebagai sudah dibaca (opsional)
            await _markAsRead(userId, notificationId);
          }
        } else {
          print('✅ No new notifications');
        }
      } else {
        print('⚠ Server response: ${response.statusCode}');
      }
    } catch (e) {
      print('❌ Error checking notifications: $e');
    }
  }

  // Tampilkan notifikasi
  Future<void> _showNotification(Map<String, dynamic> notification) async {
    try {
      String title = notification['title'] ?? 'SAMPERIN SA KAMPUNG';
      String body = notification['message'] ?? 'Ada update status baru!';
      String type = notification['type'] ?? 'info';

      // Pilih emoji berdasarkan tipe
      String emoji = _getEmojiForType(type);

      await AwesomeNotifications().createNotification(
        content: NotificationContent(
          id: DateTime.now().millisecondsSinceEpoch.remainder(100000),
          channelKey: 'basic_channel',
          title: '$emoji $title',
          body: body,
          notificationLayout: NotificationLayout.Default,
          displayOnForeground: true,
          displayOnBackground: true,
          payload: {
            'notification_id': notification['id'].toString(),
            'type': type,
          },
        ),
      );

      print('✅ Notification displayed: $title');
    } catch (e) {
      print('❌ Error showing notification: $e');
    }
  }

  // Get emoji berdasarkan tipe notifikasi
  String _getEmojiForType(String type) {
    switch (type.toLowerCase()) {
      case 'approved':
      case 'success':
        return '✅';
      case 'rejected':
      case 'failed':
        return '❌';
      case 'pending':
      case 'processing':
        return '⏳';
      case 'info':
        return 'ℹ️';
      case 'warning':
        return '⚠️';
      default:
        return '🔔';
    }
  }

  // Mark notification sebagai sudah dibaca (opsional)
  Future<void> _markAsRead(String userId, String notificationId) async {
    try {
      await http.post(
        Uri.parse('$baseUrl/api/notifications/mark-read'),
        headers: {'Content-Type': 'application/json'},
        body: jsonEncode({
          'id': userId,
          'notification_id': notificationId,
        }),
      );
      print('📬 Notification marked as read: $notificationId');
    } catch (e) {
      print('⚠️ Error marking notification as read: $e');
    }
  }

  // Manual check (untuk pull-to-refresh)
  Future<void> manualCheck() async {
    print('🔄 Manual notification check triggered');
    await _checkForNotifications();
  }

  // Get status polling
  bool get isRunning => _isRunning;
}

