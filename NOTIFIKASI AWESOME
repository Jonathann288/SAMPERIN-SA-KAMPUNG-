class HomePage extends StatefulWidget {
  const HomePage({super.key});

  @override
  State<HomePage> createState() => _HomePageState();
}

class _HomePageState extends State<HomePage> {
  int _selectedIndex = -1;
  int notificationId = 0;

  @override
  void initState() {
    super.initState();

    // Setup listener untuk ketika notifikasi di-tap
    AwesomeNotifications().setListeners(
      onActionReceivedMethod: onActionReceivedMethod,
    );
  }

  // Method yang dipanggil ketika notifikasi di-tap
  static Future<void> onActionReceivedMethod(
      ReceivedAction receivedAction) async {
    print('Notifikasi di-klik: ${receivedAction.id}');
  }

  // Method untuk menampilkan notifikasi
  Future<void> sendNotification() async {
    try {
      await AwesomeNotifications().createNotification(
        content: NotificationContent(
          id: notificationId++,
          channelKey: 'basic_channel',
          title: '📢 SAMPERIN SA KAMPUNG',
          body:
              'Layanan pajak kendaraan bermotor telah tersedia di kampung Anda!',
          notificationLayout: NotificationLayout.Default,
          displayOnForeground: true,
          displayOnBackground: true,
        ),
      );
    } catch (e) {
      print('Error sending notification: $e');
      if (mounted) {
        showCustomSnackBar(context, 'Gagal mengirim notifikasi: $e',
            success: false);
      }
    }
  }

  void _onNavTapped(int index) {
    setState(() {
      _selectedIndex = index;
    });

    if (index == 0) {
      Navigator.push(
          context,
          MaterialPageRoute(
              builder: (context) =>
                  const FormPage(layanan: 'Booking Antrian')));
    } else if (index == 1) {
      Navigator.push(
          context, MaterialPageRoute(builder: (context) => const SearchPage()));
    } else if (index == 2) {
      Navigator.push(context,
          MaterialPageRoute(builder: (context) => const PanduanPage()));
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: SafeArea(
        child: SingleChildScrollView(
          child: Column(
            children: [
              Container(
                width: double.infinity,
                padding:
                    const EdgeInsets.symmetric(vertical: 15, horizontal: 20),
                decoration: const BoxDecoration(color: Color(0xFFc4d9e6)),
                child: Row(
                  children: [
                    Image.asset('assets/logoPPS.png', width: 35, height: 35),
                    const SizedBox(width: 15),
                    Image.asset('assets/logo-samsat.png',
                        width: 45, height: 45),
                    const SizedBox(width: 15),
                    const Expanded(
                      child: Text(
                        'SAMPERIN SA KAMPUNG',
                        style: TextStyle(
                            fontSize: 18,
                            fontWeight: FontWeight.bold,
                            color: Color(0xFF003366)),
                      ),
                    ),
                  ],
                ),
              ),
              Container(
                width: double.infinity,
                height: 240,
                decoration: BoxDecoration(
                  border: Border.all(color: Colors.white, width: 4),
                  image: const DecorationImage(
                      image: AssetImage('assets/samperin.png'),
                      fit: BoxFit.cover),
                ),
              ),
              Padding(
                padding: const EdgeInsets.symmetric(horizontal: 20),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const SizedBox(height: 15),
                    const Text(
                      'Kenapa SAMPERIN?',
                      style: TextStyle(
                          fontWeight: FontWeight.bold,
                          fontSize: 18,
                          color: Color(0xFF0057A3)),
                    ),
                    const SizedBox(height: 10),
                    const Text(
                      'Layanan jemput bola untuk pembayaran dan administrasi perpajakan kendaraan bermotor di kampung-kampung terpencil.',
                      style: TextStyle(fontSize: 14, height: 1.4),
                    ),
                    const SizedBox(height: 25),

                    // Tombol untuk mengirim notifikasi
                    Center(
                      child: ElevatedButton.icon(
                        onPressed: sendNotification,
                        icon: const Icon(Icons.notifications_active, size: 22),
                        label: const Text(
                          'Kirim Notifikasi Test',
                          style: TextStyle(
                              fontSize: 16, fontWeight: FontWeight.w600),
                        ),
                        style: ElevatedButton.styleFrom(
                          backgroundColor: Color(0xFF0057A3),
                          foregroundColor: Colors.white,
                          padding: const EdgeInsets.symmetric(
                              horizontal: 30, vertical: 15),
                          shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(12),
                          ),
                          elevation: 3,
                        ),
                      ),
                    ),

                    const SizedBox(height: 50),
                  ],
                ),
              ),
            ],
          ),
        ),
      ),
      bottomNavigationBar: BottomNavigationBar(
        currentIndex: _selectedIndex == -1 ? 0 : _selectedIndex,
        onTap: _onNavTapped,
        backgroundColor: const Color(0xFF0057A3),
        selectedItemColor: Colors.white,
        unselectedItemColor: Colors.white70,
        type: BottomNavigationBarType.fixed,
        items: const [
          BottomNavigationBarItem(
              icon: Icon(Icons.add), label: 'Ajukan Permintaan'),
          BottomNavigationBarItem(icon: Icon(Icons.search), label: 'Search'),
          BottomNavigationBarItem(icon: Icon(Icons.help), label: 'Panduan'),
        ],
      ),
    );
  }

  @override
  void dispose() {
    AwesomeNotifications().dispose();
    super.dispose();
  }
}
