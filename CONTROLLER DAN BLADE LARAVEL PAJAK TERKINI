<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\Http;

class AntrianController extends Controller
{
    /**
     * GET all bookings
     */
    public function index()
    {
        try {
            $response = Http::timeout(10)->get(env('BACKEND_API_URL') . '/booking/all');

            $data = $response->successful()
                ? ($response->json()['data'] ?? [])
                : [];
        } catch (\Exception $e) {
            \Log::error('Backend error:', ['msg' => $e->getMessage()]);
            $data = [];
        }

        return view('antrian', compact('data'));
    }


    /**
     * SHOW detail booking
     * backend TIDAK ada endpoint /booking/:id
     * jadi ambil dari /booking/all lalu filter
     */
    public function show($id)
    {
        try {
            $response = Http::timeout(10)->get(env('BACKEND_API_URL') . "/booking/all");

            if ($response->successful()) {
                $all = $response->json()['data'] ?? [];
                $data = collect($all)->firstWhere('id', (int)$id);
            } else {
                $data = null;
            }
        } catch (\Exception $e) {
            \Log::error("🔥 Error ambil detail booking: {$id}", ['error' => $e->getMessage()]);
            $data = null;
        }

        return view('antrian-lihat', compact('data'));
    }

    /**
     * UPDATE booking
     */
    public function update(Request $request, $id)
    {
        try {
            $payload = [
                'tanggal'        => $request->input('tanggal'),
                'tim'            => $request->input('tim'),
                'catatan_admin'  => $request->input('catatan_admin'),   // FIX!
                'harga'          => $request->input('harga'),           // FIX!
                'status'         => $request->input('status'),
            ];

            \Log::info("📦 UPDATE PAYLOAD BOOKING {$id}", $payload);

            $response = Http::timeout(10)
                ->asJson()
                ->put(env('BACKEND_API_URL') . "/booking/update/{$id}", $payload);

            if ($response->successful()) {
                return redirect()->route('antrian')->with('success', '✅ Data berhasil diperbarui.');
            }

            \Log::error("⚠️ Gagal update booking {$id}", [
                'status' => $response->status(),
                'body'   => $response->body(),
            ]);

            return redirect()->back()->with('error', '⚠️ Gagal update data.');
        } catch (\Exception $e) {
            \Log::error("🔥 Exception update booking {$id}", ['error' => $e->getMessage()]);
            return redirect()->back()->with('error', '❌ Error: ' . $e->getMessage());
        }
    }
}


