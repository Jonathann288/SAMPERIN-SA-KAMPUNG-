package utils

import (
	"crypto/md5"
	"encoding/hex"
	"fmt"
	"time"
)

// GenerateSimpleToken membuat token sederhana berbasis MD5
func GenerateSimpleToken(nomorHP string, userID uint) string {
	raw := fmt.Sprintf("%s:%d:%d", nomorHP, userID, time.Now().UnixNano())
	hash := md5.Sum([]byte(raw))
	return hex.EncodeToString(hash[:])
}
