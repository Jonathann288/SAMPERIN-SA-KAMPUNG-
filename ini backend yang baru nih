// ======================================================
// FCM CONFIG
// ======================================================
var FCMServerKey = "ISI_DENGAN_SERVER_KEY_FIREBASE_MU"

// sementara token disimpan di memori, nanti bisa dari database
var UserTokens []string

// Fungsi untuk mengirim notifikasi ke semua token
func sendNotificationToAll(title, body string) {
	for _, token := range UserTokens {
		sendNotification(token, title, body)
	}
}

func sendNotification(token, title, body string) {
	payload := map[string]interface{}{
		"to": token,
		"notification": map[string]string{
			"title": title,
			"body":  body,
		},
	}
	payloadBytes, _ := json.Marshal(payload)
	req, _ := http.NewRequest("POST", "https://fcm.googleapis.com/fcm/send", bytes.NewBuffer(payloadBytes))
	req.Header.Set("Authorization", "key="+FCMServerKey)
	req.Header.Set("Content-Type", "application/json")

	client := &http.Client{}
	resp, err := client.Do(req)
	if err != nil {
		fmt.Println("❌ Gagal kirim FCM:", err)
		return
	}
	defer resp.Body.Close()
	fmt.Println("✅ Notifikasi terkirim ke:", token, "| Status:", resp.Status)
}

// ======================================================
// REGISTER TOKEN DARI FLUTTER
// ======================================================
func RegisterToken(c *gin.Context) {
	var body struct {
		Token string `json:"token"`
	}

	if err := c.ShouldBindJSON(&body); err != nil || body.Token == "" {
		utils.Error(c, "Token tidak valid")
		return
	}

	UserTokens = append(UserTokens, body.Token)
	fmt.Println("📱 Token baru disimpan:", body.Token)

	utils.Success(c, "Token berhasil disimpan")
}

// ======================================================
// STRUCT INPUT
// ======================================================
type BookingInput struct {
	Nama           string `json:"nama" binding:"required"`
	NomorKendaraan string `json:"nomor_kendaraan" binding:"required"`
	NomorHP        string `json:"nomor_hp" binding:"required"`
	JenisLayanan   string `json:"jenis_layanan" binding:"required"`
	Kampung        string `json:"kampung" binding:"required"`
	Catatan        string `json:"catatan"`
}

// ======================================================
// CREATE BOOKING
// ======================================================
func CreateBooking(c *gin.Context) {
	var input BookingInput
	if err := c.ShouldBindJSON(&input); err != nil {
		utils.Error(c, err.Error())
		return
	}

	fmt.Println("Jenis layanan diterima:", input.JenisLayanan)
	jenis := strings.ToLower(strings.TrimSpace(input.JenisLayanan))

	defaultTim := "-"
	defaultCatatanAdmin := "-"
	defaultHarga := "-"
	defaultTanggal := time.Time{}

	switch jenis {
	case "pajak kendaraan bermotor":
		booking := models.PajakKendaraanBermotor{
			Nama:           input.Nama,
			NomorKendaraan: input.NomorKendaraan,
			NomorHP:        input.NomorHP,
			Tanggal:        defaultTanggal,
			Kampung:        input.Kampung,
			Catatan:        input.Catatan,
			Tim:            defaultTim,
			CatatanAdmin:   defaultCatatanAdmin,
			Harga:          defaultHarga,
		}
		config.DB.Create(&booking)

	case "balik nama kendaraan":
		booking := models.BalikNamaKendaraan{
			Nama:           input.Nama,
			NomorKendaraan: input.NomorKendaraan,
			NomorHP:        input.NomorHP,
			Tanggal:        defaultTanggal,
			Kampung:        input.Kampung,
			Catatan:        input.Catatan,
			Tim:            defaultTim,
			CatatanAdmin:   defaultCatatanAdmin,
			Harga:          defaultHarga,
		}
		config.DB.Create(&booking)

	case "mutasi kendaraan":
		booking := models.MutasiKendaraan{
			Nama:           input.Nama,
			NomorKendaraan: input.NomorKendaraan,
			NomorHP:        input.NomorHP,
			Tanggal:        defaultTanggal,
			Kampung:        input.Kampung,
			Catatan:        input.Catatan,
			Tim:            defaultTim,
			CatatanAdmin:   defaultCatatanAdmin,
			Harga:          defaultHarga,
		}
		config.DB.Create(&booking)

	default:
		utils.Error(c, "Jenis layanan tidak valid")
		return
	}

	utils.Success(c, "Booking berhasil disimpan")
}

// ======================================================
// UPDATE BOOKING + NOTIFIKASI
// ======================================================
func UpdateBooking(c *gin.Context) {
	id := c.Param("id")

	var booking models.PajakKendaraanBermotor
	if err := config.DB.First(&booking, id).Error; err != nil {
		utils.Error(c, "Data booking tidak ditemukan")
		return
	}

	var input struct {
		Tanggal      string `json:"tanggal"`
		Tim          string `json:"tim"`
		CatatanAdmin string `json:"catatan_admin"`
		Harga        string `json:"harga"`
		Status       string `json:"status"`
	}

	if err := c.ShouldBindJSON(&input); err != nil {
		utils.Error(c, "Input tidak valid: "+err.Error())
		return
	}

	if input.Tanggal != "" {
		parsedDate, err := time.Parse("2006-01-02", input.Tanggal)
		if err != nil {
			utils.Error(c, "Format tanggal harus YYYY-MM-DD")
			return
		}
		booking.Tanggal = parsedDate
	}

	if input.Tim != "" {
		booking.Tim = input.Tim
	}
	if input.CatatanAdmin != "" {
		booking.CatatanAdmin = input.CatatanAdmin
	}
	if input.Harga != "" {
		booking.Harga = input.Harga
	}
	if input.Status != "" {
		booking.Status = input.Status
	}

	if err := config.DB.Save(&booking).Error; err != nil {
		utils.Error(c, "Gagal menyimpan perubahan: "+err.Error())
		return
	}

	// Kirim notifikasi ke semua pengguna
	title := "Status Diperbarui"
	body := fmt.Sprintf("Pesanan atas nama %s kini berstatus: %s", booking.Nama, booking.Status)
	sendNotificationToAll(title, body)

	utils.Success(c, gin.H{
		"message": "Booking berhasil diperbarui dan notifikasi dikirim",
		"data":    booking,
	})
}
