<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\Http;

class MutasiController extends Controller
{
    /**
     * 🔹 Menampilkan daftar semua data Mutasi dari backend
     */
    public function index()
    {
        try {
            // Ambil semua data dari endpoint backend
            $response = Http::timeout(5)->get(env('BACKEND_API_URL') . "/mutasikendaraan/all");

            if ($response->successful()) {
                $allData = $response->json()['data'] ?? [];
                $data = collect($allData)->values()->all();
            } else {
                \Log::error('❌ Gagal ambil data Mutasi', [
                    'status' => $response->status(),
                    'body'   => $response->body(),
                ]);
                $data = [];
            }
        } catch (\Exception $e) {
            \Log::error('🔥 Gagal koneksi ke backend Mutasi:', ['error' => $e->getMessage()]);
            $data = [];
        }

        // ✅ Pastikan view "mutasi" dikirimkan variabel $data
        return view('mutasi', compact('data'));
    }

    /**
     * 🔹 Menampilkan detail satu data Mutasi berdasarkan ID
     */
    public function show($id)
    {
        try {
            $response = Http::timeout(5)->get(env('BACKEND_API_URL') . "/mutasikendaraan/all");

            if ($response->successful()) {
                $allData = $response->json()['data'] ?? [];
                $data = collect($allData)->firstWhere('id', (int) $id);
            } else {
                $data = null;
            }
        } catch (\Exception $e) {
            \Log::error('🔥 Exception ambil detail Mutasi:', ['error' => $e->getMessage()]);
            $data = null;
        }

        return view('mutasi-lihat', compact('data'));
    }

    /**
     * 🔹 Update data Mutasi (PUT /mutasikendaraan/update/:id)
     */
    public function update(Request $request, $id)
    {
        try {
            $payload = [
                'tanggal'        => $request->input('tanggal'),
                'tim'            => $request->input('tim'),
                'catatan_admin'  => $request->input('catatan'),
                'harga'          => $request->input('total'),
                'status'         => $request->input('status'),
            ];

            \Log::info('📦 Payload dikirim ke backend:', $payload);

            // Mengirim update ke backend Go
            $response = Http::timeout(5)
                ->withHeaders([
                    'Accept'       => 'application/json',
                    'Content-Type' => 'application/json',
                ])
                ->asJson()
                ->put(env('BACKEND_API_URL') . "/mutasikendaraan/update/{$id}", $payload);

            if ($response->successful()) {
                // Kirim notifikasi ke backend Go
                Http::post(env('BACKEND_GO_API_URL') . "/send-notification", [
                    'status' => $request->input('status'),
                    'vehicle_number' => $request->input('vehicle_number'),
                ]);

                \Log::info('✅ Update sukses:', $response->json());
                return redirect()->route('mutasi')->with('success', '✅ Data Mutasi berhasil diperbarui.');
            } else {
                \Log::error('⚠️ Gagal update data backend', [
                    'status' => $response->status(),
                    'body'   => $response->body(),
                ]);
                return redirect()->back()->with('error', '⚠️ Gagal memperbarui data Mutasi.');
            }
        } catch (\Exception $e) {
            \Log::error('🔥 Exception saat update data Mutasi:', ['error' => $e->getMessage()]);
            return redirect()->back()->with('error', '🔥 Terjadi kesalahan: ' . $e->getMessage());
        }
    }
}
