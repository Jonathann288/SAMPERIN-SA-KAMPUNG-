ini admin controller
package controllers

import (
    "net/http"
    "samsat_backend/config"
    "samsat_backend/models"
    "golang.org/x/crypto/bcrypt"
    "github.com/gin-gonic/gin"
)

// 🔹 Login admin global (bcrypt)
func AdminLogin(c *gin.Context) {
    var input struct {
        Username string `json:"username"`
        Password string `json:"password"`
    }

    if err := c.ShouldBindJSON(&input); err != nil {
        c.JSON(http.StatusBadRequest, gin.H{"error": "Input tidak valid"})
        return
    }

    var admin models.Admin
    if err := config.DB.Where("username = ?", input.Username).First(&admin).Error; err != nil {
        c.JSON(http.StatusUnauthorized, gin.H{"error": "Username tidak ditemukan"})
        return
    }

    // ✅ Bandingkan hash password
    if err := bcrypt.CompareHashAndPassword([]byte(admin.Password), []byte(input.Password)); err != nil {
        c.JSON(http.StatusUnauthorized, gin.H{"error": "Password salah"})
        return
    }

    // ✅ Login sukses
    c.JSON(http.StatusOK, gin.H{
        "status":  "success",
        "message": "Login berhasil",
        "data": gin.H{
            "id":       admin.ID,
            "username": admin.Username,
            "nama":     admin.Nama,
            "role":     admin.Role,
        },
    })
}

ini route

package routes

import (
	"samsat_backend/controllers"

	"github.com/gin-gonic/gin"
)

func SetupRoutes(r *gin.Engine) {
	//  Tambah data booking
	r.POST("/booking", controllers.CreateBooking)

	//  Ambil semua data booking (atau cari via query)
	r.GET("/booking/search", controllers.SearchBooking)

	//  Ambil detail booking berdasarkan ID (buat antrian-lihat)
	r.GET("/booking/all", controllers.GetAllBookings)

	//  Update data booking
	r.PUT("/booking/update/:id", controllers.UpdateBooking)

	//  Cek update untuk notifikasi lokal
	r.GET("/check-update", controllers.CheckUpdate)

	//  register token
	r.POST("/register-token", controllers.RegisterToken)

	//  Update data balik nama
	r.PUT("/baliknama/update/:id", controllers.UpdateBalikNama)

	// ambill detail balik nama berdasarkan ID
	r.GET("/baliknama/all", controllers.GetAllBalikNama)

	// Update data mutasi kendaraan
	r.PUT("/mutasikendaraan/update/:id", controllers.UpdateMutasi)

	// ambil detail mutasi kendaraan berdasarkan ID
	r.GET("/mutasikendaraan/all", controllers.GetAllMutasi)

	// AUTH
	r.POST("/register", controllers.Register)
	r.POST("/login", controllers.Login)
	r.POST("/logout", controllers.Logout)
	r.GET("/profil/", controllers.Profil)

	//login admin
	// 🔹 Login admin (global)
    r.POST("/admin/login", controllers.AdminLogin)


}


