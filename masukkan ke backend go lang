func RegisterToken(w http.ResponseWriter, r *http.Request) {
    var req struct {
        Token string `json:"token"`
    }
    json.NewDecoder(r.Body).Decode(&req)
    if req.Token == "" {
        http.Error(w, "Token kosong", http.StatusBadRequest)
        return
    }

    // Simpan token ke database (misalnya tabel "user_tokens")
    // Di sini untuk demo, kita simpan di slice global
    userTokens = append(userTokens, req.Token)

    w.WriteHeader(http.StatusOK)
    json.NewEncoder(w).Encode(map[string]string{"message": "Token diterima"})
}
